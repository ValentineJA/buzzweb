# Copy to .env.local. Never commit private values.
APP_URL=http://localhost:3000

# Firebase Console > Project settings > Your apps > Web app config (public identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin service account (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the PEM on one quoted line, with literal \n between lines.
FIREBASE_PRIVATE_KEY=""

# MongoDB Atlas connection string and database (server only)
MONGODB_URI=
MONGODB_DB=buzz_development

# Enable only in an isolated development/test deployment.
ENABLE_TEST_ACCOUNTS=false
NEXT_PUBLIC_ENABLE_TEST_ACCOUNTS=false
# Explicitly repeat the development Firebase project ID before running the seed.
FIREBASE_TEST_PROJECT_ID=
NEXT_PUBLIC_TEST_USER1_EMAIL=user1@buzz.test
NEXT_PUBLIC_TEST_USER2_EMAIL=user2@buzz.test
TEST_USER1_PASSWORD=
TEST_USER2_PASSWORD=